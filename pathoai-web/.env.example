# pathoai-web — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# URL of the shared PathoAI backend API.
# In development: http://127.0.0.1:8000
# In production:  https://your-api-domain.com
PATHOAI_API_BASE_URL=http://127.0.0.1:8000

# Port for the local dev static server (server.js)
PORT=5500
