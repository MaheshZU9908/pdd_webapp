# PathoAI Backend — Environment Variables
# Copy this file to .env and fill in your values.

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.a9elc1z.mongodb.net/?appName=Cluster0
DB_NAME=pathoai_db

# Secret key for JWT signing
SECRET_KEY=pathoai-secret-key-change-in-production

# Algorithm for JWT
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:5500

# Path to PyTorch AI model weights (optional)
PATHOAI_MODEL=models/model.pth
